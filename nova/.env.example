# DeepSeek LLM (primary reasoning engine)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_MODE=enabled
MAX_TOKENS=8192

# Prolog Reasoner (SWI-Prolog)
# SWIPL_PATH=swipl

# Lean 4 Integration
# LEAN_PROJECT_DIR=~/lean4-sandbox
LEAN_TIMEOUT_SECONDS=120

# GitHub API
GITHUB_TOKEN=

# Proof Specialists
DEEPSEEK_PROVER_API_KEY=
DEEPSEEK_PROVER_BASE_URL=https://api.novita.ai/openai
DEEPSEEK_PROVER_MODEL=deepseek/deepseek-prover-v2-671b
BFS_PROVER_MODEL=ByteDance-Seed/BFS-Prover-V2-32B
BFS_PROVER_API_KEY=
HF_TOKEN=

# Web Search
# LANGSEARCH_API_KEY=

# NOVA-specific configuration
NOVA_KNOWLEDGE_GRAPH_PATH=nova_knowledge_graph.json
NOVA_PROOF_LIBRARY_PATH=nova_proof_library.json
NOVA_MAX_AGENTS=5
NOVA_DEFAULT_CONFIDENCE_THRESHOLD=0.7
NOVA_VERIFICATION_BUDGET=100
NOVA_LEARNED_PATTERNS_MAX=5000
